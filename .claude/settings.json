{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Bash(npm view *)",

      "Bash(make *)",
      "Bash(bun *)",
      "Bash(bunx *)",

      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(cmp *)",
      "Bash(comm *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(jq *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(perl *)",
      "Bash(python3 *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(test *)",
      "Bash(tee *)",
      "Bash(stat *)",
      "Bash(du *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(realpath *)",
      "Bash(which *)",
      "Bash(date *)",
      "Bash(curl *)",

      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(ln *)",
      "Bash(rm *)",

      "Bash(git *)",

      "Bash(gh *)",

      "Bash(docker ps*)",
      "Bash(docker logs*)",
      "Bash(claude -p *)",
      "Bash(claude mcp list*)",
      "Bash(claude plugin list*)",
      "mcp__postgres"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh repo create*)",
      "Bash(gh api*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git stash clear*)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm ci*)",
      "Bash(npm add*)",
      "Bash(npm update*)",
      "Bash(npm uninstall*)",
      "Bash(npm link*)",
      "Bash(npm publish*)",
      "Bash(yarn *)",
      "Bash(pnpm *)"
    ]
  },
  "extraKnownMarketplaces": {
    "app-template": { "source": { "source": "directory", "path": "./.misc/claude" } }
  },
  "enabledPlugins": {
    "tsgo-lsp@app-template": true,
    "typescript-lsp@claude-plugins-official": false,
    "mattpocock-skills@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "superpowers@anthropic-plugin-directory": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "code-simplifier@anthropic-plugin-directory": false,
    "commit-commands@claude-plugins-official": false,
    "code-review-anthropics@anthropic-plugin-directory": false,
    "context7@anthropic-plugin-directory": false
  },
  "worktree": { "baseRef": "head" },
  "claudeMdExcludes": ["**/node_modules/**"],
  "disableClaudeAiConnectors": true
}
