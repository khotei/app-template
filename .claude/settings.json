{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",

      "Bash(make *)",
      "Bash(bun *)",
      "Bash(bunx *)",
      "Bash(lychee *)",

      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(cmp *)",
      "Bash(comm *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(jq *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(perl *)",
      "Bash(python3 *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(test *)",
      "Bash(tee *)",
      "Bash(stat *)",
      "Bash(du *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(realpath *)",
      "Bash(which *)",
      "Bash(date *)",
      "Bash(curl *)",

      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(ln *)",
      "Bash(rm *)",

      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git grep*)",
      "Bash(git ls-files*)",
      "Bash(git ls-remote*)",
      "Bash(git rev-parse*)",
      "Bash(git rev-list*)",
      "Bash(git cat-file*)",
      "Bash(git check-ignore*)",
      "Bash(git merge-base*)",
      "Bash(git config --get*)",
      "Bash(git remote -v*)",
      "Bash(git fetch*)",
      "Bash(git add *)",
      "Bash(git commit*)",
      "Bash(git mv *)",
      "Bash(git rm *)",
      "Bash(git restore*)",
      "Bash(git reset*)",
      "Bash(git stash*)",
      "Bash(git apply*)",
      "Bash(git cherry-pick*)",
      "Bash(git branch*)",
      "Bash(git switch *)",
      "Bash(git checkout*)",
      "Bash(git worktree *)",

      "Bash(gh *)",

      "Bash(docker ps*)",
      "Bash(docker logs*)",
      "Bash(docker compose ps*)",
      "Bash(claude mcp list*)",
      "Bash(claude plugin list*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh repo create*)",
      "Bash(gh api*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(git branch -f*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git switch *--discard-changes*)",
      "Bash(find *-delete*)",
      "Bash(find *-exec*)"
    ],
    "deny": ["Bash(rm -rf *)", "Bash(sudo *)", "Bash(npm *)", "Bash(yarn *)", "Bash(pnpm *)"]
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "superpowers@anthropic-plugin-directory": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "code-simplifier@anthropic-plugin-directory": false,
    "commit-commands@claude-plugins-official": false,
    "code-review-anthropics@anthropic-plugin-directory": false,
    "context7@anthropic-plugin-directory": false
  },
  "disableClaudeAiConnectors": true,
  "deniedMcpServers": [
    { "serverName": "notion" },
    { "serverName": "claude-in-chrome" },
    { "serverName": "computer-use" }
  ]
}
