{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun *)",
      "Bash(bunx *)",
      "Bash(make *)",
      "Bash(lychee *)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(sort*)",
      "Bash(uniq*)",
      "Bash(diff *)",
      "Bash(jq *)",
      "Bash(mkdir *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git grep*)",
      "Bash(git ls-files*)",
      "Bash(git ls-remote*)",
      "Bash(git rev-parse*)",
      "Bash(git merge-base*)",
      "Bash(git remote -v*)",
      "Bash(git fetch*)",
      "Bash(git branch*)",
      "Bash(git switch *)",
      "Bash(git commit*)",
      "Bash(git add *)",
      "Bash(git mv *)",
      "Bash(git rm *)",
      "Bash(git reset*)",
      "Bash(git stash*)",
      "Bash(git worktree list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr status*)",
      "Bash(gh pr list*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "WebSearch",
      "WebFetch"
    ],
    "ask": [
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh repo create*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(git branch -f*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git switch *--discard-changes*)",
      "Bash(find *-delete*)",
      "Bash(find *-exec*)"
    ],
    "deny": ["Bash(rm -rf *)", "Bash(sudo *)", "Bash(npm *)", "Bash(yarn *)", "Bash(pnpm *)"]
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "superpowers@anthropic-plugin-directory": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "code-simplifier@anthropic-plugin-directory": false,
    "commit-commands@claude-plugins-official": false,
    "code-review-anthropics@anthropic-plugin-directory": false
  }
}
