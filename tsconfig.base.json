{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    // Environment
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "types": ["node"],

    // Bundler mode: Node and Bun run .ts sources, workspaces export .ts directly
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,

    // Project references: composite forbids noEmit (TS6310), so tsc -b emits
    // declarations only, into each workspace's gitignored outDir
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,

    // Strictness
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,

    // Effect diagnostics, read only by the effect-tsgo binary: the patched tsc and the editor
    // language server. bun check and a stock tsserver ignore plugins. unstableApiUsage is an
    // editor-only suggestion, because unstable modules are used by choice and at warning each
    // import of one fails tsc -b (docs/knowledge/tooling.md › TypeScript). The override holds the
    // ban on ambient time, ids, fetch and the environment of application/CLAUDE.md
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": { "unstableApiUsage": "suggestion" },
        "includeSuggestionsInTsc": false,
        "overrides": [
          {
            "include": ["application/**/*.ts"],
            "options": {
              "diagnosticSeverity": {
                "globalDate": "error",
                "globalDateInEffect": "error",
                "cryptoRandomUUID": "error",
                "cryptoRandomUUIDInEffect": "error",
                "globalFetch": "error",
                "globalFetchInEffect": "error",
                "processEnv": "error",
                "processEnvInEffect": "error"
              }
            }
          }
        ]
      }
    ]
  }
}
