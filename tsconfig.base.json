{
  "compilerOptions": {
    // Environment
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "types": ["bun"],

    // Bundler mode: Bun runs .ts sources, workspaces export .ts directly
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,

    // Project references: composite forbids noEmit (TS6310), so tsc -b emits
    // declarations only, into each workspace's gitignored outDir
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,

    // Strictness
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  }
}
