{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    // Environment
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "types": ["bun"],

    // Bundler mode: Bun runs .ts sources, workspaces export .ts directly
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,

    // Project references: composite forbids noEmit (TS6310), so tsc -b emits
    // declarations only, into each workspace's gitignored outDir
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,

    // Strictness
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Effect diagnostics, read only by the effect-tsgo binary: the patched tsc and the editor
    // language server. bun check and a stock tsserver ignore plugins. unstableApiUsage is an
    // editor-only suggestion, because unstable modules are used by choice and at warning each
    // import of one fails tsc -b (docs/knowledge/tooling.md › TypeScript)
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": { "unstableApiUsage": "suggestion" },
        "includeSuggestionsInTsc": false
      }
    ]
  }
}
