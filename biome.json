                      "@app-template/chat",
                      "@app-template/chat/**",
                      "@app-template/use-cases",
                      "@app-template/use-cases/**",
                      "@app-template/api",
                      "@app-template/api/**",
                      "@app-template/worker",
                      "@app-template/worker/**",
                      "@app-template/web",
                      "@app-template/web/**",
                      "@app-template/http-api",
                      "@app-template/http-api/**"
                    ],
                    "message": "deployment may import only the kernel and packages/*"
                  },
                  {
                    "group": ["./**", "../**"],
                    "message": "inside a workspace import through its #<workspace>/\u2026 subpath, never a relative path"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
