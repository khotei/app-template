{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!bun.lock", "!repos", "!infrastructure/db/migrations"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noCommonJs": "error",
        "useImportType": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["./**", "../**"],
                "message": "inside a workspace import through its #<workspace>/\u2026 subpath, never a relative path"
              }
            ]
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noImportCycles": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":BUN:", ":NODE:"],
              ":BLANK_LINE:",
              [":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:", ":URL:", "!@app-template/**"],
              ":BLANK_LINE:",
              "@app-template/**",
              ":BLANK_LINE:",
              ":ALIAS:"
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@app-template/**",
                      "@effect/**",
                      "!@effect/vitest",
                      "!@effect/vitest/**"
                    ],
                    "message": "domain is the pure core: it imports no workspace and no @effect/* package except the test runner @effect/vitest"
                  },
                  {
                    "group": ["./**", "../**"],
                    "message": "inside a workspace import through its #<workspace>/\u2026 subpath, never a relative path"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["domain/__tests__/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@app-template/**",
                      "!@app-template/testing",
                      "!@app-template/testing/**",
                      "@effect/**",
                      "!@effect/vitest",
                      "!@effect/vitest/**",
                      "!@effect/platform-bun",
                      "!@effect/platform-bun/**"
                    ],
                    "message": "domain tests import no workspace but @app-template/testing, and no @effect/* package except the test runner @effect/vitest and @effect/platform-bun for BunCrypto.layer"
                  },
                  {
                    "group": [
                      "#testing-e2e/**",
                      "@app-template/*/testing-e2e",
                      "@app-template/*/testing-e2e/**"
                    ],
                    "message": "a unit test and its support import no e2e support (#testing-e2e/\u2026, @app-template/*/testing-e2e): unit tests run with no container"
                  },
                  {
                    "group": ["./**", "../**"],
                    "message": "inside a workspace import through its #<workspace>/\u2026 subpath, never a relative path"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
