        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@app-template/**", "@effect/**"],
                    "message": "a module contract imports no workspace and no @effect/* package: every consumer of the module reads it"
                  },
                  {
                    "group": ["./**", "../**"],
                    "message": "inside a workspace import through its #<workspace>/\u2026 subpath, never a relative path"
