{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!bun.lock", "!repos", "!kernel/data/migrations"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noCommonJs": "error",
        "useImportType": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["./**", "../**"],
                "message": "inside a workspace import through its #<workspace>/\u2026 subpath, never a relative path"
              }
            ]
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noImportCycles": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":BUN:", ":NODE:"],
              ":BLANK_LINE:",
              [":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:", ":URL:", "!@app-template/**"],
              ":BLANK_LINE:",
              "@app-template/**",
              ":BLANK_LINE:",
              ":ALIAS:"
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["http-api/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@app-template/**",
                      "!@app-template/*-contract",
                      "!@app-template/*-contract/**",
                      "!@app-template/*/domain",
                      "@effect/**"
                    ],
                    "message": "http-api is the HTTP boundary shared by the apps: it imports only effect, the module contracts and a module's domain"
                  },
                  {
                    "group": ["./**", "../**"],
                    "message": "inside a workspace import through its #<workspace>/\u2026 subpath, never a relative path"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["application/*/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@app-template/**",
                      "!@app-template/*-contract",
                      "!@app-template/*-contract/**",
                      "@effect/**"
                    ],
                    "message": "a module's domain is pure and ships to the browser: it imports no workspace but the module contracts, and no @effect/* package"
                  },
                  {
                    "group": ["#services/**", "#infrastructure/**"],
                    "message": "a module's domain imports neither its services nor its infrastructure"
                  },
                  {
                    "group": ["./**", "../**"],
                    "message": "inside a workspace import through its #<workspace>/\u2026 subpath, never a relative path"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["application/*/services/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@app-template/**",
                      "!@app-template/aws",
                      "!@app-template/db",
                      "!@app-template/queue",
                      "!@app-template/kernel/aws/resources",
                      "!@app-template/kernel/data/*",
                      "!@app-template/*-contract",
                      "!@app-template/*-contract/**",
                      "@effect/**"
                    ],
                    "message": "a module's services import no workspace but @app-template/db for generateId and the mappers' codecs, @app-template/aws and @app-template/queue for the job definitions, the inventory (@app-template/kernel/aws/resources), the data layer's stores (@app-template/kernel/data/*) and the module contracts, and no @effect/* package"
                  },
                  {
                    "group": ["#infrastructure/**"],
                    "message": "a module's services reach its infrastructure only through a port"
                  },
                  {
                    "group": ["./**", "../**"],
                    "message": "inside a workspace import through its #<workspace>/\u2026 subpath, never a relative path"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["application/*/infrastructure/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@app-template/use-cases",
                      "@app-template/use-cases/**",
                      "@app-template/api",
                      "@app-template/api/**",
                      "@app-template/worker",
                      "@app-template/worker/**",
                      "@app-template/web",
                      "@app-template/web/**",
                      "@app-template/deployment",
                      "@app-template/deployment/**",
                      "@app-template/http-api",
                      "@app-template/http-api/**",
                      "@app-template/*/services",
                      "@app-template/*/services/**"
                    ],
                    "message": "a module's infrastructure may import its domain, the contracts, the kernel and packages/*: no upward imports, no module's services"
                  },
                  {
                    "group": ["./**", "../**"],
                    "message": "inside a workspace import through its #<workspace>/\u2026 subpath, never a relative path"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["application/*/contract/**"],
