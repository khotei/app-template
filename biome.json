{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!bun.lock", "!repos", "!infrastructure/db/migrations"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noCommonJs": "error",
        "useImportType": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["./**", "../**"],
                "message": "inside a workspace import through its #<workspace>/\u2026 subpath, never a relative path"
              }
            ]
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noImportCycles": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":BUN:", ":NODE:"],
              ":BLANK_LINE:",
              [":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:", ":URL:", "!@app-template/**"],
              ":BLANK_LINE:",
              "@app-template/**",
              ":BLANK_LINE:",
              ":ALIAS:"
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@app-template/**",
                      "@effect/**",
                      "!@effect/vitest",
                      "!@effect/vitest/**"
                    ],
                    "message": "domain is the pure core: it imports no workspace and no @effect/* package except the test runner @effect/vitest"
                  },
                  {
                    "group": ["./**", "../**"],
                    "message": "inside a workspace import through its #<workspace>/\u2026 subpath, never a relative path"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["domain/tests/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@app-template/**",
                      "!@app-template/testing",
                      "!@app-template/testing/**",
                      "@effect/**",
                      "!@effect/vitest",
                      "!@effect/vitest/**",
                      "!@effect/platform-bun",
                      "!@effect/platform-bun/**"
                    ],
                    "message": "domain tests import no workspace but the test support @app-template/testing, and no @effect/* package except the test runner @effect/vitest and @effect/platform-bun for BunCrypto.layer"
                  },
                  {
                    "group": ["./**", "../**"],
                    "message": "inside a workspace import through its #<workspace>/\u2026 subpath, never a relative path"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["http-api/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@app-template/**",
                      "!@app-template/domain",
                      "!@app-template/domain/**",
                      "@effect/**"
                    ],
                    "message": "http-api is the HTTP boundary shared by the apps: it imports only effect and @app-template/domain"
                  },
                  {
                    "group": ["./**", "../**"],
                    "message": "inside a workspace import through its #<workspace>/\u2026 subpath, never a relative path"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["infrastructure/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@app-template/application",
                      "@app-template/application/**",
                      "@app-template/api",
                      "@app-template/api/**",
                      "@app-template/worker",
                      "@app-template/worker/**",
                      "@app-template/web",
                      "@app-template/web/**",
                      "@app-template/deployment",
                      "@app-template/deployment/**",
                      "@app-template/http-api",
                      "@app-template/http-api/**"
                    ],
                    "message": "infrastructure may import only domain and packages/*: no upward imports"
                  },
                  {
                    "group": ["./**", "../**"],
                    "message": "inside a workspace import through its #<workspace>/\u2026 subpath, never a relative path"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["application/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@app-template/api",
                      "@app-template/api/**",
                      "@app-template/worker",
                      "@app-template/worker/**",
                      "@app-template/web",
                      "@app-template/web/**",
                      "@app-template/deployment",
                      "@app-template/deployment/**",
                      "@app-template/http-api",
                      "@app-template/http-api/**"
                    ],
                    "message": "application may import infrastructure, domain and packages/*: no upward imports"
                  },
                  {
                    "group": ["./**", "../**"],
                    "message": "inside a workspace import through its #<workspace>/\u2026 subpath, never a relative path"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@app-template/domain",
                      "@app-template/domain/**",
                      "@app-template/infrastructure",
                      "@app-template/infrastructure/**",
                      "@app-template/application",
                      "@app-template/application/**",
                      "@app-template/api",
                      "@app-template/api/**",
                      "@app-template/worker",
                      "@app-template/worker/**",
                      "@app-template/web",
                      "@app-template/web/**",
                      "@app-template/deployment",
                      "@app-template/deployment/**",
                      "@app-template/http-api",
                      "@app-template/http-api/**"
                    ],
                    "message": "packages/* are generic: they may import each other, but never a layer (http-api included) or an app"
                  },
                  {
                    "group": ["./**", "../**"],
                    "message": "inside a workspace import through its #<workspace>/\u2026 subpath, never a relative path"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@app-template/worker",
                      "@app-template/worker/**",
                      "@app-template/web",
                      "@app-template/web/**",
                      "@app-template/deployment",
                      "@app-template/deployment/**"
                    ],
                    "message": "apps are independent: api must not import another app"
                  },
                  {
                    "group": ["./**", "../**"],
                    "message": "inside a workspace import through its #<workspace>/\u2026 subpath, never a relative path"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/worker/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@app-template/api",
                      "@app-template/api/**",
                      "@app-template/web",
                      "@app-template/web/**",
                      "@app-template/deployment",
                      "@app-template/deployment/**",
                      "@app-template/http-api",
                      "@app-template/http-api/**"
                    ],
                    "message": "apps are independent: worker must not import another app"
                  },
                  {
                    "group": ["./**", "../**"],
                    "message": "inside a workspace import through its #<workspace>/\u2026 subpath, never a relative path"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@app-template/**",
                      "!@app-template/http-api",
                      "!@app-template/http-api/**",
                      "!@app-template/ui",
                      "!@app-template/ui/**"
                    ],
                    "message": "web client code may import only @app-template/http-api and @app-template/ui: it ships to the browser"
                  },
                  {
                    "group": ["./**", "../**"],
                    "message": "inside a workspace import through its #<workspace>/\u2026 subpath, never a relative path"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/main.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@app-template/**",
                      "!@app-template/ui",
                      "!@app-template/ui/**",
                      "!@app-template/config",
                      "!@app-template/config/**"
                    ],
                    "message": "the web server entry imports only @app-template/ui and @app-template/config of our workspaces, never @app-template/http-api"
                  },
                  {
                    "group": ["./**", "../**"],
                    "message": "inside a workspace import through its #<workspace>/\u2026 subpath, never a relative path"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["deployment/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@app-template/domain",
                      "@app-template/domain/**",
                      "@app-template/infrastructure",
                      "@app-template/infrastructure/**",
                      "@app-template/application",
                      "@app-template/application/**",
                      "@app-template/api",
                      "@app-template/api/**",
                      "@app-template/worker",
                      "@app-template/worker/**",
                      "@app-template/web",
                      "@app-template/web/**",
                      "@app-template/http-api",
                      "@app-template/http-api/**"
                    ],
                    "message": "deployment may import only packages/*"
                  },
                  {
                    "group": ["./**", "../**"],
                    "message": "inside a workspace import through its #<workspace>/\u2026 subpath, never a relative path"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
