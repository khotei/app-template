{
  "name": "@app-template/kernel",
  "private": true,
  "type": "module",
  "exports": {
    "./config": "./config/index.ts",
    "./postgres": "./postgres/index.ts",
    "./aws": "./aws/index.ts",
    "./data": "./data/index.ts",
    "./llm": "./llm/index.ts",
    "./queue": "./queue/index.ts",
    "./data/testing": "./data/__tests__/testing/index.ts",
    "./data/testing-e2e": "./data/__e2e__/testing/index.ts",
    "./aws/testing-e2e": "./aws/__e2e__/testing/index.ts"
  },
  "imports": {
    "#kernel/*": "./*.ts",
    "#testing/data/*": "./data/__tests__/testing/*.ts",
    "#testing-e2e/data/*": "./data/__e2e__/testing/*.ts",
    "#testing-e2e/aws/*": "./aws/__e2e__/testing/*.ts"
  },
  "dependencies": {
    "@app-template/packages": "workspace:*",
    "@effect-aws/client-s3": "catalog:effect-aws",
    "@effect-aws/client-sqs": "catalog:effect-aws",
    "@effect/platform-bun": "catalog:effect",
    "@effect/sql-pg": "catalog:effect",
    "drizzle-orm": "catalog:drizzle",
    "effect": "catalog:effect",
    "type-fest": "catalog:runtime"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:effect",
    "@testcontainers/postgresql": "catalog:runtime",
    "testcontainers": "catalog:runtime",
    "vitest": "catalog:tools"
  }
}
