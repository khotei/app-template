{
  "name": "@app-template/kernel",
  "private": true,
  "type": "module",
  "exports": {
    "./config": "./config/index.ts",
    "./postgres": "./postgres/index.ts",
    "./aws": "./aws/index.ts",
    "./aws/resources": "./aws/resources/index.ts",
    "./data": "./data/index.ts",
    "./data/chat": "./data/chat/index.ts",
    "./data/attachment": "./data/attachment/index.ts",
    "./data/user": "./data/user/index.ts",
    "./data/job": "./data/job/index.ts",
    "./data/file": "./data/file/index.ts",
    "./llm": "./llm/index.ts",
    "./queue": "./queue/index.ts",
    "./testing": "./__tests__/testing/index.ts",
    "./testing-e2e": "./__e2e__/testing/index.ts"
  },
  "imports": {
    "#kernel/*": "./*.ts",
    "#testing/*": "./__tests__/testing/*.ts",
    "#testing-e2e/*": "./__e2e__/testing/*.ts"
  },
  "dependencies": {
    "@app-template/aws": "workspace:*",
    "@app-template/db": "workspace:*",
    "@app-template/llm": "workspace:*",
    "@app-template/queue": "workspace:*",
    "@app-template/s3": "workspace:*",
    "@effect-aws/client-s3": "catalog:effect-aws",
    "@effect-aws/client-sqs": "catalog:effect-aws",
    "@effect/platform-bun": "catalog:effect",
    "@effect/sql-pg": "catalog:effect",
    "drizzle-orm": "catalog:drizzle",
    "effect": "catalog:effect",
    "type-fest": "catalog:runtime"
  },
  "devDependencies": {
    "@app-template/testing": "workspace:*",
    "@effect/vitest": "catalog:effect",
    "@testcontainers/postgresql": "catalog:runtime",
    "testcontainers": "catalog:runtime",
    "vitest": "catalog:tools"
  }
}
