{
  "name": "@app-template/packages",
  "private": true,
  "type": "module",
  "exports": {
    "./aws": "./aws/index.ts",
    "./aws/queue": "./aws/queue/index.ts",
    "./aws/s3": "./aws/s3/index.ts",
    "./db": "./db/index.ts",
    "./schema": "./schema/index.ts",
    "./testing": "./testing/index.ts",
    "./ui": "./ui/index.ts",
    "./aws/queue/testing": "./aws/queue/__tests__/testing/index.ts",
    "./db/testing": "./db/__tests__/testing/index.ts",
    "./aws/testing/e2e": "./aws/__tests__/testing/e2e/index.ts",
    "./db/testing/e2e": "./db/__tests__/testing/e2e/index.ts"
  },
  "imports": {
    "#aws/*": "./aws/*.ts",
    "#db/*": "./db/*.ts",
    "#schema/*": "./schema/*.ts",
    "#testing/*": "./testing/*.ts",
    "#ui/*": "./ui/*.ts",
    "#testing/aws/queue/*": "./aws/queue/__tests__/testing/*.ts",
    "#testing/db/*": "./db/__tests__/testing/*.ts",
    "#testing/aws/e2e/*": "./aws/__tests__/testing/e2e/*.ts",
    "#testing/db/e2e/*": "./db/__tests__/testing/e2e/*.ts"
  },
  "dependencies": {
    "@effect-aws/client-s3": "catalog:effect-aws",
    "@effect-aws/client-sqs": "catalog:effect-aws",
    "@effect/sql-pg": "catalog:effect",
    "@effect/vitest": "catalog:effect",
    "drizzle-orm": "catalog:drizzle",
    "effect": "catalog:effect",
    "vitest": "catalog:tools"
  },
  "devDependencies": {
    "@effect-aws/client-lambda": "catalog:effect-aws",
    "@effect/platform-bun": "catalog:effect"
  }
}
