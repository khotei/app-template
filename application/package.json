{
  "name": "@app-template/application",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./chat": "./chat/index.ts",
    "./identity": "./identity/index.ts",
    "./use-cases": "./use-cases/index.ts",
    "./chat/testing": "./chat/__tests__/testing/index.ts",
    "./use-cases/testing": "./use-cases/__tests__/testing/index.ts"
  },
  "imports": {
    "#chat/*": "./chat/*.ts",
    "#identity/*": "./identity/*.ts",
    "#use-cases/*": "./use-cases/*.ts",
    "#testing/chat/*": "./chat/__tests__/testing/*.ts",
    "#testing/use-cases/*": "./use-cases/__tests__/testing/*.ts"
  },
  "dependencies": {
    "@app-template/kernel": "workspace:*",
    "@app-template/packages": "workspace:*",
    "effect": "catalog:effect",
    "type-fest": "catalog:runtime"
  },
  "devDependencies": {
    "@effect/ai-anthropic": "catalog:effect",
    "@effect/platform-bun": "catalog:effect",
    "@effect/vitest": "catalog:effect"
  }
}
