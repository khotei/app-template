{
  "name": "@app-template/application",
  "private": true,
  "type": "module",
  "exports": {
    "./chat": "./chat/index.ts",
    "./chat/contract": "./chat/contract/index.ts",
    "./identity": "./identity/index.ts",
    "./identity/contract": "./identity/contract/index.ts",
    "./user": "./user/index.ts",
    "./user/contract": "./user/contract/index.ts",
    "./http-api": "./http-api/index.ts",
    "./chat/testing": "./chat/__tests__/testing/index.ts"
  },
  "imports": {
    "#chat/*": "./chat/*.ts",
    "#identity/*": "./identity/*.ts",
    "#user/*": "./user/*.ts",
    "#http-api/*": "./http-api/*.ts",
    "#testing/chat/*": "./chat/__tests__/testing/*.ts",
    "#testing/identity/*": "./identity/__tests__/testing/*.ts"
  },
  "dependencies": {
    "@app-template/kernel": "workspace:*",
    "@app-template/packages": "workspace:*",
    "@effect/ai-anthropic": "catalog:effect",
    "effect": "catalog:effect",
    "type-fest": "catalog:runtime"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:effect",
    "@effect/vitest": "catalog:effect"
  }
}
