{
  "name": "@app-template/chat",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./domain": "./domain/index.ts",
    "./services": "./services/index.ts",
    "./infrastructure": "./infrastructure/index.ts",
    "./testing": "./__tests__/testing/index.ts"
  },
  "imports": {
    "#domain/*": "./domain/*.ts",
