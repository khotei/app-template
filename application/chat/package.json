    "@app-template/identity-contract": "workspace:*",
    "@app-template/kernel": "workspace:*",
    "@app-template/queue": "workspace:*",
    "effect": "catalog:effect",
    "type-fest": "catalog:runtime"
  },
  "devDependencies": {
    "@app-template/testing": "workspace:*",
    "@effect/ai-anthropic": "catalog:effect",
    "@effect/platform-bun": "catalog:effect",
    "@effect/vitest": "catalog:effect"
  }
