{
  "name": "app-template",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "imports": {
    "#lint/*": "./.misc/lint/*.mjs"
  },
  "workspaces": [
    "application",
    "kernel",
    "packages",
    "apps/*",
    "deployment"
  ],
  "scripts": {
    "prepare": "husky && effect-tsgo patch"
  },
  "catalogs": {
    "tools": {
      "@biomejs/biome": "2.6.8",
      "husky": "9.1.7",
      "markdownlint-cli2": "0.24.2",
      "vitest": "5.1.0"
    },
    "runtime": {
      "@testcontainers/postgresql": "12.2.2",
      "@types/bun": "1.4.5",
      "@types/node": "24.19.4",
      "testcontainers": "12.2.2",
      "type-fest": "6.0.3"
    },
    "typescript": {
      "@effect/tsgo": "0.73.2",
      "typescript": "7.0.2"
    },
    "effect": {
      "@effect/ai-anthropic": "4.1.5",
      "@effect/openapi-generator": "4.1.5",
      "@effect/platform-bun": "4.1.5",
      "@effect/platform-node": "4.1.5",
      "@effect/sql-pg": "4.1.5",
      "@effect/vitest": "4.1.5",
      "effect": "4.1.5"
    },
    "effect-aws": {
      "@effect-aws/client-lambda": "2.0.0",
      "@effect-aws/client-s3": "2.0.0",
      "@effect-aws/client-sqs": "2.0.0"
    },
    "pulumi": {
      "@pulumi/aws": "7.55.0",
      "@pulumi/docker": "5.3.0",
      "@pulumi/pulumi": "3.277.0"
    },
    "drizzle": {
      "drizzle-kit": "1.0.0-rc.6",
      "drizzle-orm": "1.0.0-rc.6"
    },
    "alchemy": {
      "@alchemy.run/aws": "2.0.0-beta.87",
      "alchemy": "2.0.0-beta.87"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:tools",
    "@effect/tsgo": "catalog:typescript",
    "@types/bun": "catalog:runtime",
    "@types/node": "catalog:runtime",
    "drizzle-kit": "catalog:drizzle",
    "husky": "catalog:tools",
    "markdownlint-cli2": "catalog:tools",
    "typescript": "catalog:typescript",
    "vitest": "catalog:tools"
  }
}
