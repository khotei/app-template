{
  "name": "app-template",
  "owner": { "name": "App Template" },
  "plugins": [
    {
      "name": "tsgo-lsp",
      "description": "TypeScript LSP on the project's pinned tsc, the Effect plugin included",
      "source": "./",
      "strict": false,
      "lspServers": {
        "typescript": {
          "command": "${CLAUDE_PROJECT_DIR}/node_modules/.bin/tsc",
          "args": ["--lsp", "--stdio"],
          "workspaceFolder": "${CLAUDE_PROJECT_DIR}",
          "extensionToLanguage": {
            ".ts": "typescript",
            ".tsx": "typescriptreact",
            ".mts": "typescript",
            ".cts": "typescript"
          }
        }
      }
    }
  ]
}
