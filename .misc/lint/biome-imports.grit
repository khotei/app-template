language js

pattern specifier($source) {
  or {
    JsModuleSource() as $source,
    `import($source, $...)`,
    `require($source)`,
    `require.resolve($source, $...)`,
    `import.meta.resolve($source, $...)`,
    `vi.$loader($source, $...)` where {
      $loader <: or {
        "mock",
        "doMock",
        "unmock",
        "doUnmock",
        "importActual",
        "importMock"
      }
    },
    TsImportType() as $type where { $type <: contains TsStringLiteralType() as $source }
  }
}

// The last ring folder on the absolute $filename (apps/<app>, application, deployment, http-api,
// kernel, packages) names the ring whose workspaces the ring rules below check.
pattern ring($ring) {
  r".*/(apps/[a-z0-9-]+|application|deployment|http-api|kernel|packages)/.*"($ring)
}

// $filename is absolute: the last application/, kernel/ or packages/ folder on the path names the
// unit; a #<unit>/…, #kernel/<unit>/… or #testing/<unit>/… specifier names the unit it reaches.
// Every capture group is required, as one left unmatched aborts the plugin on the whole file.
or {
  specifier($source) where {
    $filename <: r".*/(?:application|kernel|packages)/([a-z0-9-]+)/.*"($unit),
    $source <: r"['\"`]#(?:kernel/|testing/)?([a-z0-9-]+)/.*['\"`]"($target),
    not $target <: $unit,
    register_diagnostic(span=$source, message="a unit reaches its own files through #<unit>/… and another unit only through its entry, @app-template/<folder>/<unit> or its /testing, never one of its files (decisions.md › Imports through subpaths)")
  },
  specifier($source) where {
    $filename <: ring($ring),
    $ring <: "packages",
    $source <: r"['\"`]@app-template/([a-z0-9-]+).*['\"`]"($workspace),
    not $workspace <: "packages",
    register_diagnostic(span=$source, message="packages/ imports no other workspace, whatever its manifest declares: only @app-template/packages/<package> (decisions.md › One kernel)")
  },
  specifier($source) where {
    $filename <: ring($ring),
    $ring <: or {
      "apps/api",
      "apps/worker",
      "apps/web"
    },
    $source <: r"['\"`]@app-template/([a-z0-9-]+).*['\"`]"($workspace),
    not $workspace <: or {
      "application",
      "http-api",
      "kernel",
      "packages"
    },
    register_diagnostic(span=$source, message="an app imports no other app and no deployment, whatever its manifest declares: only @app-template/{application,http-api,kernel,packages}/… (decisions.md › Independent apps)")
  },
  specifier($source) where {
    $filename <: ring($ring),
    $ring <: "deployment",
    $source <: r"['\"`]@app-template/([a-z0-9-]+)/?([a-z0-9-]*).*['\"`]"($workspace, $kernelPart),
    or {
      not $workspace <: or {
        "kernel",
        "packages"
      },
      and {
        $workspace <: "kernel",
        not $kernelPart <: or {
          "aws",
          "config",
          "data"
        }
      }
    },
    register_diagnostic(span=$source, message="deployment imports no workspace but packages/* and of the kernel /config, /aws and /data, whatever its manifest declares (decisions.md › One kernel)")
  },
  specifier($source) where {
    $source <: r"['\"`]\.\.?/.*['\"`]",
    register_diagnostic(span=$source, message="inside a workspace import through its #<workspace>/… subpath, never a relative path (decisions.md › Imports through subpaths)")
  }
}
