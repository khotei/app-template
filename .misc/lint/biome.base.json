{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!bun.lock", "!repos", "!kernel/data/migrations", "!http-api/openapi.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "plugins": ["./.misc/lint/biome-imports.grit", "./.misc/lint/biome-effect.grit"],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noCommonJs": "error",
        "useImportType": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noImportCycles": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":BUN:", ":NODE:"],
              ":BLANK_LINE:",
              [":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:", ":URL:", "!@app-template/**"],
              ":BLANK_LINE:",
              "@app-template/**",
              ":BLANK_LINE:",
              ":ALIAS:"
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["http-api/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@app-template/**", "@effect/**"],
                    "message": "the API contract imports only effect: no workspace and no @effect/* package (decisions.md › The API contract on its own; Guards are configuration)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/**", "!apps/web/main.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@app-template/**", "!@app-template/{http-api,packages/ui}"],
                    "message": "web client code may import only @app-template/http-api and @app-template/packages/ui: it ships to the browser (decisions.md › HTTP outside the modules; Guards are configuration)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["application/*/contract/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@app-template/**", "@effect/**"],
                    "message": "a module contract imports no workspace and no @effect/* package: every consumer of the module reads it (decisions.md › Module contracts; Guards are configuration)"
                  },
                  {
                    "group": ["#*/index", "#*/domain/**", "#*/services/**", "#*/infrastructure/**"],
                    "message": "a module contract imports none of its module's other files: every consumer of the module reads it (decisions.md › Module contracts)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["application/*/domain/**", "application/*/__tests__/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@app-template/**",
                      "!@app-template/application/*",
                      "!@app-template/application/*/testing",
                      "!@app-template/packages/testing",
                      "@app-template/application/use-cases",
                      "@app-template/application/use-cases/**",
                      "@effect/**",
                      "!@effect/vitest",
                      "!@effect/vitest/**"
                    ],
                    "message": "a module's domain is pure: it imports no workspace but another module's entry, for its contract, and no @effect/* package; its tests add test support, a module's /testing, @app-template/packages/testing and @effect/vitest (decisions.md › A module's layers; Module contracts; Guards are configuration)"
                  },
                  {
                    "group": ["#*/services/**", "#*/infrastructure/**"],
                    "message": "a module's domain imports neither its services nor its infrastructure (decisions.md › A module's layers)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["application/*/services/**", "application/*/__tests__/services/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@app-template/**",
                      "!@app-template/packages/{db,queue,testing}",
                      "!@app-template/packages/{db,queue}/testing",
                      "!@app-template/kernel/{aws,data}",
                      "!@app-template/kernel/{aws,data}/testing",
                      "!@app-template/application/*",
                      "!@app-template/application/*/testing",
                      "@app-template/application/use-cases",
                      "@app-template/application/use-cases/**",
                      "@effect/**",
                      "!@effect/vitest",
                      "!@effect/vitest/**",
                      "!@effect/platform-bun"
                    ],
                    "message": "a module's services import no workspace but @app-template/packages/db for generateId and the mappers' codecs, @app-template/packages/queue for the job definitions, the inventory (@app-template/kernel/aws), the data layer's stores (@app-template/kernel/data) and another module's entry, and no @effect/* package: no use case, no boundary part such as @app-template/kernel/llm; its tests add test support, the /testing of those, @app-template/packages/testing, @effect/vitest and @effect/platform-bun (decisions.md › A module's layers; Module contracts; Use cases above the modules; The language model in the kernel; Guards are configuration)"
                  },
                  {
                    "group": ["@app-template/kernel/aws"],
                    "importNamePattern": "[A-Za-z0-9]+(FromConfig|OfStage)",
                    "message": "of @app-template/kernel/aws a module's services take only the inventory: the configured clients are the boundary the processes provide (decisions.md › Clients from the context)"
                  },
                  {
                    "group": ["@app-template/kernel/data"],
                    "importNamePattern": "(Db|relations|migrationsFolder)",
                    "message": "of @app-template/kernel/data a module's services take only the stores: the client Db, the relations and the migrations folder are the data layer's own (decisions.md › A module's layers; The data at the centre)"
                  },
                  {
                    "group": ["#*/infrastructure/**"],
                    "message": "a module's services reach its infrastructure only through a port (decisions.md › A module's layers)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["application/*/infrastructure/**", "application/*/__tests__/infrastructure/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["#*/services/**"],
                    "message": "a module's infrastructure implements its domain's ports and imports none of its services (decisions.md › A module's layers)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["application/use-cases/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@app-template/**",
                      "!@app-template/application/*",
                      "!@app-template/application/*/testing",
                      "@app-template/application/use-cases",
                      "@app-template/application/use-cases/**",
                      "!@app-template/kernel/data",
                      "!@app-template/kernel/data/testing",
                      "!@app-template/packages/*",
                      "!@app-template/packages/*/testing"
                    ],
                    "message": "the use cases import no workspace but a module's entry, the data layer (@app-template/kernel/data) and packages/*: no http-api, app or deployment above them, no boundary part of the kernel (/config, /postgres, /aws, /queue, /llm), which the processes provide; their tests add the /testing of those (decisions.md › Use cases above the modules; Clients from the context; Guards are configuration)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["application/*/index.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@app-template/**"],
                    "message": "an entry of application/ re-exports its own files through #<unit>/… and imports no workspace (decisions.md › Module contracts; Guards are configuration)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["kernel/data/**", "!kernel/data/__tests__/**", "!kernel/data/__e2e__/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@app-template/**",
                      "!@app-template/packages/*",
                      "@app-template/packages/testing"
                    ],
                    "message": "the data layer imports no workspace but packages/*: no module or model, no other kernel part such as @app-template/kernel/config; it takes its clients from the context (decisions.md › The data at the centre; Clients from the context; Guards are configuration)"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
