# Runtime
NODE_ENV="development"
LOG_LEVEL="Info"

# Apps
API_PORT=3000
WEB_PORT=3001

# Queue: both apps run from apps/<app>, so the path lands in the root .data/
QUEUE_SQLITE_PATH="../../.data/queue.sqlite"
QUEUE_LOCK_EXPIRATION="15 seconds"
QUEUE_LOCK_REFRESH_INTERVAL="5 seconds"

# Store: the api and the worker share one directory of key files
STORE_PATH="../../.data/store"

# Stubbed services: uncomment when the matching client is implemented
# DATABASE_URL="postgres://app-template:app-template@localhost:5432/app-template"
# S3_ENDPOINT="http://localhost:4566"
# S3_BUCKET="app-template-documents"
# QUEUE_URL="http://localhost:4566/000000000000/app-template-jobs"
# LLM_API_KEY=""
