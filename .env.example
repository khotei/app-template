# Runtime
NODE_ENV="development"
LOG_LEVEL="Info"

# Apps
API_PORT=3000
WEB_PORT=3001

# Queue: how long a received job stays hidden from other workers, and how often its worker extends that
QUEUE_LOCK_EXPIRATION="15 seconds"
QUEUE_LOCK_REFRESH_INTERVAL="5 seconds"

# Store: the api and the worker share one directory of key files
STORE_PATH="../../.data/store"

# AWS: resource names are app-template-<STAGE>-<resource>; the endpoint is MiniStack (`make up`).
# The SDK reads the credentials itself; MiniStack accepts any.
AWS_REGION="us-east-1"
AWS_ENDPOINT_URL="http://localhost:4566"
STAGE="local"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"

# Stubbed services: uncomment when the matching client is implemented
# DATABASE_URL="postgres://app-template:app-template@localhost:5432/app-template"
# LLM_API_KEY=""
