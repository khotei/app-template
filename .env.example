# Runtime
NODE_ENV="development"
LOG_LEVEL="Info"

# Apps
API_PORT=3000
WEB_PORT=3001

# Queue: how long a received job stays hidden from other workers, and how often its worker extends that
QUEUE_LOCK_EXPIRATION="15 seconds"
QUEUE_LOCK_REFRESH_INTERVAL="5 seconds"
# How long the worker's outbox relay waits once a poll has drained the outbox
OUTBOX_POLL_INTERVAL="1 second"

# AWS: resource names are app-template-<STAGE>-<resource>; the endpoint is MiniStack (`make up`).
# The SDK reads the credentials itself; MiniStack accepts any.
AWS_REGION="us-east-1"
AWS_ENDPOINT_URL="http://localhost:4566"
STAGE="local"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"

# Local stand: the host port MiniStack gives the database instance; `make up` writes the
# database's URL to .env.pulumi
RDS_BASE_PORT=15432

# Language model: `stub` answers canned text with no key; `anthropic` needs the key and both models
LLM_PROVIDER="stub"
# ANTHROPIC_API_KEY=""
# LLM_REPLY_MODEL="claude-sonnet-5-5"
# LLM_TITLE_MODEL="claude-haiku-5-5"
