# Runtime
NODE_ENV="development"
LOG_LEVEL="Info"

# Apps
API_PORT=3000
WEB_PORT=3001
# The worker answers the batches MiniStack's SQS mappings send to POST /events
WORKER_PORT=3002

# AWS: resource names are app-template-<STAGE>-<resource>; the endpoint is MiniStack (`make up`).
# The SDK reads the credentials itself; MiniStack accepts any.
AWS_REGION="us-east-1"
AWS_ENDPOINT_URL="http://localhost:4566"
STAGE="local"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"

# Local stand: the host port MiniStack gives the database instance; `make up` writes the
# database's URL to .env.pulumi
RDS_BASE_PORT=15432

# Telemetry: `make up` runs the local backend (grafana/otel-lgtm, a 3.6 GB image, about 900 MiB of
# memory), Grafana on GRAFANA_PORT and OTLP on the endpoint's port. A signal leaves only when its
# OTEL_<SIGNAL>_EXPORTER lists otlp; on AWS the same variables name its OTLP endpoints.
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_TRACES_EXPORTER="otlp"
OTEL_LOGS_EXPORTER="otlp"
OTEL_METRICS_EXPORTER="otlp"
GRAFANA_PORT=3003

# Language model: Anthropic's key and the models that answer replies and titles
ANTHROPIC_API_KEY=""
LLM_REPLY_MODEL="claude-sonnet-5-5"
# The tokens a chat's context may hold: at most the reply model's context window; a chat is cut at 0.8 of it
LLM_CHAT_CONTEXT_TOKENS_LIMIT="1000000"
LLM_TITLE_MODEL="claude-haiku-5-5"
