{
  "name": "@app-template/web",
  "private": true,
  "type": "module",
  "imports": {
    "#web/index.html": "./index.html",
    "#web/*": "./*.ts"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --env-file=../../.env.pulumi --hot main.ts",
    "debug": "bun --env-file=../../.env --env-file=../../.env.pulumi --inspect --hot main.ts"
  },
  "dependencies": {
    "@app-template/packages": "workspace:*",
    "effect": "catalog:effect"
  },
  "browserPackages": [
    "effect",
    "@app-template/packages/ui"
  ],
  "devDependencies": {
    "@effect/openapi-generator": "catalog:effect",
    "@effect/vitest": "catalog:effect"
  }
}
