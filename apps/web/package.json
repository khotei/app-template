{
  "name": "@app-template/web",
  "private": true,
  "type": "module",
  "imports": {
    "#web/index.html": "./src/index.html",
    "#web/*": "./src/*.ts"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --env-file=../../.env.pulumi --hot src/main.ts",
    "debug": "bun --env-file=../../.env --env-file=../../.env.pulumi --inspect --hot src/main.ts",
    "start": "bun --env-file=../../.env --env-file=../../.env.pulumi src/main.ts"
  },
  "dependencies": {
    "@app-template/config": "workspace:*",
    "@app-template/http-api": "workspace:*",
    "@app-template/ui": "workspace:*",
    "effect": "catalog:effect"
  }
}
