{
  "name": "@app-template/web",
  "private": true,
  "type": "module",
  "imports": {
    "#web/index.html": "./index.html",
    "#web/*": "./*.ts"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --env-file=../../.env.pulumi --hot main.ts",
    "debug": "bun --env-file=../../.env --env-file=../../.env.pulumi --inspect --hot main.ts",
    "start": "bun --env-file=../../.env --env-file=../../.env.pulumi main.ts"
  },
  "dependencies": {
    "@app-template/config": "workspace:*",
    "@app-template/http-api": "workspace:*",
    "@app-template/ui": "workspace:*",
    "effect": "catalog:effect"
  }
}
