{
  "name": "@app-template/worker",
  "private": true,
  "type": "module",
  "imports": {
    "#worker/*": "./src/*.ts"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --env-file=../../.env.pulumi --watch src/main.ts",
    "debug": "bun --env-file=../../.env --env-file=../../.env.pulumi --inspect --watch src/main.ts",
    "start": "bun --env-file=../../.env --env-file=../../.env.pulumi src/main.ts"
  },
  "dependencies": {
    "@app-template/application": "workspace:*",
    "@app-template/config": "workspace:*",
    "@app-template/infrastructure": "workspace:*",
    "@app-template/llm": "workspace:*",
    "@app-template/queue": "workspace:*",
    "@effect/platform-bun": "catalog:effect",
    "effect": "catalog:effect"
  }
}
