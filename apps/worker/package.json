{
  "name": "@app-template/worker",
  "private": true,
  "type": "module",
  "exports": {
    "./testing": "./__tests__/testing/index.ts"
  },
  "imports": {
    "#worker/*": "./*.ts",
    "#testing/*": "./__tests__/testing/*.ts"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --env-file=../../.env.pulumi --watch main.ts",
    "debug": "bun --env-file=../../.env --env-file=../../.env.pulumi --inspect --watch main.ts",
    "start": "bun --env-file=../../.env --env-file=../../.env.pulumi main.ts"
  },
  "dependencies": {
    "@app-template/application": "workspace:*",
    "@app-template/kernel": "workspace:*",
    "@app-template/packages": "workspace:*",
    "@effect/platform-bun": "catalog:effect",
    "effect": "catalog:effect"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:effect"
  }
}
