{
  "name": "@app-template/api",
  "private": true,
  "type": "module",
  "imports": {
    "#api/*": "./*.ts"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --env-file=../../.env.pulumi --hot main.ts",
    "debug": "bun --env-file=../../.env --env-file=../../.env.pulumi --inspect --hot main.ts",
    "start": "bun --env-file=../../.env --env-file=../../.env.pulumi main.ts"
  },
  "dependencies": {
    "@app-template/application": "workspace:*",
    "@app-template/config": "workspace:*",
    "@app-template/domain": "workspace:*",
    "@app-template/http-api": "workspace:*",
    "@app-template/infrastructure": "workspace:*",
    "@effect/platform-bun": "catalog:effect",
    "effect": "catalog:effect"
  },
  "devDependencies": {
    "@app-template/queue": "workspace:*",
    "@app-template/testing": "workspace:*",
    "@effect/vitest": "catalog:effect"
  }
}
