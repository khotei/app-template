language js

or {
  `import $_ from $source`,
  `import type $_ from $source`,
  `import $source`,
  `export { $_ } from $source`,
  `export type { $_ } from $source`,
  `export * from $source`,
  `import($source)`
} where {
  $source <: r"['\"](?:#[a-z-]+/testing/.*|@app-template/testing(?:/.*)?)['\"]",
  register_diagnostic(span=$source, severity="error", message="test support (a testing/ folder, @app-template/testing) is imported only by tests and other test support")
}
